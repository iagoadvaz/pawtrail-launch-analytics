      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "WHY IT MATTERS",
      "originalText": "WHY IT MATTERS",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e294148240",
      "type": "text",
      "x": 682,
      "y": 710.5,
      "width": 401.62,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2045768074,
      "version": 1,
      "versionNonce": 623047443,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Rule 2 is what separates analysis from storytelling. If a\nmetric does not trigger, the finding IS the metric; a\nthreshold moved to fit an observation cannot afterwards be\nevidence about that observation.",
      "originalText": "Rule 2 is what separates analysis from storytelling. If a\nmetric does not trigger, the finding IS the metric; a\nthreshold moved to fit an observation cannot afterwards be\nevidence about that observation.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
