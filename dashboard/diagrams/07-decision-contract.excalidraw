      "link": null,
      "locked": false,
      "text": "WHY IT MATTERS",
      "originalText": "WHY IT MATTERS",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e107713942",
      "type": "text",
      "x": 18,
      "y": 335.75,
      "width": 422.29,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1249291279,
      "version": 1,
      "versionNonce": 2123366212,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "A dashboard that only reports numbers cannot be wrong.\nDeclaring the threshold and the consequence BEFORE observing\nthe value is what makes the analysis falsifiable -- and 17 of\n29 firing is a finding, not a failure of the contract.",
      "originalText": "A dashboard that only reports numbers cannot be wrong.\nDeclaring the threshold and the consequence BEFORE observing\nthe value is what makes the analysis falsifiable -- and 17 of\n29 firing is a finding, not a failure of the contract.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
