    },
    {
      "id": "e781726802",
      "type": "text",
      "x": 682,
      "y": 618.0,
      "width": 422.29,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1670670865,
      "version": 1,
      "versionNonce": 1597441891,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Rule 1: a categorical threshold is written to catch the WORST\nsegment, so the reduction is direction-aware -- max for an\n'above' rule, min for a 'below' one. Rule 2: thresholds are\nfixed before the value is read.",
      "originalText": "Rule 1: a categorical threshold is written to catch the WORST\nsegment, so the reduction is direction-aware -- max for an\n'above' rule, min for a 'below' one. Rule 2: thresholds are\nfixed before the value is read.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e1139811866",
      "type": "text",
      "x": 682,
      "y": 694.0,
      "width": 76.2,
      "height": 12.5,
