      "roundness": null,
      "seed": 1712814955,
      "version": 1,
      "versionNonce": 1944655677,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Every row must resolve to a real value. A metric declared in\nthe contract but never produced by the semantic layer leaves a\nrow that can never fire -- an alarm wired to nothing, which\nreads as safety.",
      "originalText": "Every row must resolve to a real value. A metric declared in\nthe contract but never produced by the semantic layer leaves a\nrow that can never fire -- an alarm wired to nothing, which\nreads as safety.",
