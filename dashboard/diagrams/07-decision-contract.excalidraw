      "versionNonce": 1927457021,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "One row per metric: current value, the segment that value came\nfrom, a threshold, a direction, a status, an owner and an\naction. Status is triggered when the value crosses the\nthreshold in the declared direction.",
      "originalText": "One row per metric: current value, the segment that value came\nfrom, a threshold, a direction, a status, an owner and an\naction. Status is triggered when the value crosses the\nthreshold in the declared direction.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
