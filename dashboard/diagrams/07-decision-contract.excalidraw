      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Breaking rule 1 is silent. Reducing a categorical metric to\nits alphabetically-last row recorded Virginia at 0.0 while\nOhio sat at 0.0724 -- seven thresholds went quiet at once and\nthe dashboard looked healthier for it.",
      "originalText": "Breaking rule 1 is silent. Reducing a categorical metric to\nits alphabetically-last row recorded Virginia at 0.0 while\nOhio sat at 0.0724 -- seven thresholds went quiet at once and\nthe dashboard looked healthier for it.",
