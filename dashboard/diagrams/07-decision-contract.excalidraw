      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "The segment column is not decoration. A row reading\n'kit_lost_rate 0.072, triggered, audit the carrier' is not\nactionable until it also says OH -- without the segment,\nnobody knows where to send the auditor.",
      "originalText": "The segment column is not decoration. A row reading\n'kit_lost_rate 0.072, triggered, audit the carrier' is not\nactionable until it also says OH -- without the segment,\nnobody knows where to send the auditor.",
