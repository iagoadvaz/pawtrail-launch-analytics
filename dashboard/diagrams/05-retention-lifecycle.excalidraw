      "type": "text",
      "x": 682,
      "y": 743.0,
      "width": 415.4,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
