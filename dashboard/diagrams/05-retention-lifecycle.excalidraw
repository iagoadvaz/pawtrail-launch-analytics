      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "pct_base_never_rebilled = renewal_unexposed_accounts /\nassessable_base_accounts. GRR = (starting - churned -\ncontraction) / starting; NRR adds expansion to the numerator.",
      "originalText": "pct_base_never_rebilled = renewal_unexposed_accounts /\nassessable_base_accounts. GRR = (starting - churned -\ncontraction) / starting; NRR adds expansion to the numerator.",
