    {
      "id": "e775936023",
      "type": "text",
      "x": 682,
      "y": 388.25,
      "width": 429.18,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
