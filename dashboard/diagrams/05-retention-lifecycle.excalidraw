      "versionNonce": 1513356742,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "The hazard denominator is the at-risk population, not every\nrow at that cycle. Accounts that cancelled earlier are carried\nforward in the spine and had no opportunity to churn again;\nleaving them in understates the hazard by 24% at cycle 2 and\n31% at cycle 3 -- and worse, it flattens the curve's shape,\nthe one property that matters.",
      "originalText": "The hazard denominator is the at-risk population, not every\nrow at that cycle. Accounts that cancelled earlier are carried\nforward in the spine and had no opportunity to churn again;\nleaving them in understates the hazard by 24% at cycle 2 and\n31% at cycle 3 -- and worse, it flattens the curve's shape,\nthe one property that matters.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
