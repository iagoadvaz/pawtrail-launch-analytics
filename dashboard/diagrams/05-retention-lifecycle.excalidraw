    {
      "id": "e2126656017",
      "type": "text",
      "x": 682,
      "y": 819.25,
      "width": 429.18,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 607940693,
      "version": 1,
      "versionNonce": 1990486095,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Cycle 0 is a signup, not a renewal: nobody can skip a shipment\nthey were never due. Including its 3,000 structurally-zero\nrows in the denominator understated both rates by 41% -- skip\nread 0.0328 instead of 0.0554. The metric matched an\nindependent recomputation because the recomputation repeated\nthe same definitional error; only naming the denominator\ncaught it.",
      "originalText": "Cycle 0 is a signup, not a renewal: nobody can skip a shipment\nthey were never due. Including its 3,000 structurally-zero\nrows in the denominator understated both rates by 41% -- skip\nread 0.0328 instead of 0.0554. The metric matched an\nindependent recomputation because the recomputation repeated\nthe same definitional error; only naming the denominator\ncaught it.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
