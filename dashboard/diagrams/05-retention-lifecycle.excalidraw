    {
      "id": "e1223851035",
      "type": "text",
      "x": 682,
      "y": 295.75,
      "width": 422.29,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1465406631,
      "version": 1,
      "versionNonce": 767913513,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Survival and hazard answer different questions: how many are\nleft, versus how dangerous this particular cycle is. Plotting\nboth shows that the risk is concentrated in cycle 1 rather\nthan spread evenly.",
      "originalText": "Survival and hazard answer different questions: how many are\nleft, versus how dangerous this particular cycle is. Plotting\nboth shows that the risk is concentrated in cycle 1 rather\nthan spread evenly.",
      "fontSize": 13,
      "fontFamily": 2,
