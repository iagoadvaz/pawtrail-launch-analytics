      "roundness": null,
      "seed": 246846794,
      "version": 1,
      "versionNonce": 437902024,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Skip and pause are retention signals that are not churn -- a\npaused subscription is still a customer. Reported separately\nthey show engagement softening before cancellation does.",
      "originalText": "Skip and pause are retention signals that are not churn -- a\npaused subscription is still a customer. Reported separately\nthey show engagement softening before cancellation does.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
