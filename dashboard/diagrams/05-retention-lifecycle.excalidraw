      "versionNonce": 284630810,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Read pct_base_never_rebilled UNGROUPED. Grouped by\ncycle_exposure_cohort the numerator becomes its own\ndenominator inside cohort '0' and the card reads a\ntautological 100.0%. The first build of this card did exactly\nthat.",
      "originalText": "Read pct_base_never_rebilled UNGROUPED. Grouped by\ncycle_exposure_cohort the numerator becomes its own\ndenominator inside cohort '0' and the card reads a\ntautological 100.0%. The first build of this card did exactly\nthat.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
