      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "skip_rate = skipped_cycles / RENEWAL cycle rows; pause_rate\nlikewise. Cycle 0 is excluded from the denominator entirely.",
      "originalText": "skip_rate = skipped_cycles / RENEWAL cycle rows; pause_rate\nlikewise. Cycle 0 is excluded from the denominator entirely.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
