    {
      "id": "e28445578",
      "type": "text",
      "x": 18,
      "y": 743.0,
      "width": 415.4,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
