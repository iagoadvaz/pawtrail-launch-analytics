      "roundness": null,
      "seed": 1361518186,
      "version": 1,
      "versionNonce": 1505450661,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Value-based means a skip does not look like a downgrade. A\nskipped shipment defers revenue; it does not change what the\nsubscription is worth, so it must not enter contraction.",
      "originalText": "Value-based means a skip does not look like a downgrade. A\nskipped shipment defers revenue; it does not change what the\nsubscription is worth, so it must not enter contraction.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
