      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "It turns 'churn is out of scope because we only have 120 days'\nfrom a prose caveat into a computed fact: 11.3% of accounts\nhave not yet faced a single renewal, so no retention figure\ncan speak for them.",
      "originalText": "It turns 'churn is out of scope because we only have 120 days'\nfrom a prose caveat into a computed fact: 11.3% of accounts\nhave not yet faced a single renewal, so no retention figure\ncan speak for them.",
