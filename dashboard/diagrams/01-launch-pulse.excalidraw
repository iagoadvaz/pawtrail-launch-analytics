    {
      "id": "e1296079861",
      "type": "text",
      "x": 18,
      "y": 368.25,
      "width": 429.18,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 168572768,
      "version": 1,
      "versionNonce": 905072500,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "One number for 'is it growing'. The denominator is the\naddressable Premium base of 15,000, not every Premium account\n-- an attach rate over a population that was never offered the\nproduct measures the offer, not the product.",
      "originalText": "One number for 'is it growing'. The denominator is the\naddressable Premium base of 15,000, not every Premium account\n-- an attach rate over a population that was never offered the\nproduct measures the offer, not the product.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e101794100",
      "type": "text",
      "x": 18,
      "y": 444.25,
      "width": 81.5,
      "height": 12.5,
