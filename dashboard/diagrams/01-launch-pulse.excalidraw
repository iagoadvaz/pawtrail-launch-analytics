      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "WHAT GOES WRONG",
      "originalText": "WHAT GOES WRONG",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e83100045",
      "type": "text",
      "x": 18,
      "y": 460.75,
      "width": 422.29,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1100275758,
      "version": 1,
      "versionNonce": 2067342801,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "The attach measures are weekly SNAPSHOTS, each already\ncumulative. Summing all 17 weeks gives 0.1049 against 255,000\n'eligible' accounts -- both meaningless. The semantic layer\npins them with non_additive_dimension / window_choice: max so\nany grouping reads the latest week. Fixing this moved attach\nfrom 0.1049 to 0.20 and the target ratio from 0.699 to 1.333.",
      "originalText": "The attach measures are weekly SNAPSHOTS, each already\ncumulative. Summing all 17 weeks gives 0.1049 against 255,000\n'eligible' accounts -- both meaningless. The semantic layer\npins them with non_additive_dimension / window_choice: max so\nany grouping reads the latest week. Fixing this moved attach\nfrom 0.1049 to 0.20 and the target ratio from 0.699 to 1.333.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
