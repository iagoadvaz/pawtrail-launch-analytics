    },
    {
      "id": "e422173362",
      "type": "text",
      "x": 18,
      "y": 243.25,
      "width": 429.18,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1475265434,
      "version": 1,
      "versionNonce": 2040401216,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "attach_rate = cumulative_subscriptions /\neligible_premium_accounts, read at the LATEST signup week. 'vs\nlaunch target' divides that by the 15% target held in a dbt\nvar, so 1.0 means exactly on plan. Subscriptions sums\nweekly_new_subscriptions across all 17 signup weeks; peak week\ntakes the max of the same column.",
      "originalText": "attach_rate = cumulative_subscriptions /\neligible_premium_accounts, read at the LATEST signup week. 'vs\nlaunch target' divides that by the 15% target held in a dbt\nvar, so 1.0 means exactly on plan. Subscriptions sums\nweekly_new_subscriptions across all 17 signup weeks; peak week\ntakes the max of the same column.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e833674493",
