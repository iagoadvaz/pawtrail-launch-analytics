      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "WHY IT MATTERS",
      "originalText": "WHY IT MATTERS",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e1627447245",
      "type": "text",
      "x": 18,
      "y": 352.0,
      "width": 415.4,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 475483304,
      "version": 1,
      "versionNonce": 943651768,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Nominal CAC counts marketing spend only, so a channel that\nbuys cheap accounts which never activate looks like the\nefficient one. Loading the waste back in is what reveals the\nreal ranking: self-serve's cost is understated by half.",
      "originalText": "Nominal CAC counts marketing spend only, so a channel that\nbuys cheap accounts which never activate looks like the\nefficient one. Loading the waste back in is what reveals the\nreal ranking: self-serve's cost is understated by half.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
