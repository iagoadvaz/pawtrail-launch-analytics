      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "The exposed share is the censoring column, not a footnote.\nWithout it the average silently mixes accounts that provably\nrepaid with accounts whose payback cycle has not arrived --\nand the more recent the cohort, the more it flatters.",
      "originalText": "The exposed share is the censoring column, not a footnote.\nWithout it the average silently mixes accounts that provably\nrepaid with accounts whose payback cycle has not arrived --\nand the more recent the cohort, the more it flatters.",
