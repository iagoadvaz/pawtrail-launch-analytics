      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "avg_breakeven_cycles = breakeven_cycles_sum /\nunit_economics_accounts, using observed contribution margin\nonly -- no survival curve, no assumed lifetime.\nshare_breakeven_cycle_exposed = accounts whose breakeven cycle\nactually came due inside the window / all accounts.",
      "originalText": "avg_breakeven_cycles = breakeven_cycles_sum /\nunit_economics_accounts, using observed contribution margin\nonly -- no survival curve, no assumed lifetime.\nshare_breakeven_cycle_exposed = accounts whose breakeven cycle\nactually came due inside the window / all accounts.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
