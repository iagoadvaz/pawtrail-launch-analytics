    {
      "id": "e76503808",
      "type": "text",
      "x": 18,
      "y": 783.0,
      "width": 429.18,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 416840757,
      "version": 1,
      "versionNonce": 333996115,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "A quality-adjusted CAC. It punishes a channel that acquires\naccounts cheaply but never activates them, and it is where the\nOhio fulfilment failure surfaces in the unit economics: raw\nCAC rose 2.3x over the stretch while cost per activated rose\n2.8x.",
      "originalText": "A quality-adjusted CAC. It punishes a channel that acquires\naccounts cheaply but never activates them, and it is where the\nOhio fulfilment failure surfaces in the unit economics: raw\nCAC rose 2.3x over the stretch while cost per activated rose\n2.8x.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e488035689",
      "type": "text",
      "x": 18,
      "y": 875.25,
      "width": 81.5,
      "height": 12.5,
      "angle": 0,
      "strokeColor": "#e03131",
