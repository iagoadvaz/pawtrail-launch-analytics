      "roundness": null,
      "seed": 1977366386,
      "version": 1,
      "versionNonce": 2054852106,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "The honest substitute for LTV:CAC inside a 120-day window. LTV\nneeds a retention curve this window cannot supply; cycles-to-\nrepay needs only what has already been billed.",
      "originalText": "The honest substitute for LTV:CAC inside a 120-day window. LTV\nneeds a retention curve this window cannot supply; cycles-to-\nrepay needs only what has already been billed.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
