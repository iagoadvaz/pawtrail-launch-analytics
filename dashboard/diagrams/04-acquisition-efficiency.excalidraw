    {
      "id": "e1889654067",
      "type": "text",
      "x": 18,
      "y": 243.25,
      "width": 415.4,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1057810273,
      "version": 1,
      "versionNonce": 1243288109,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "effective_cac = loaded_spend_usd / new_subscriptions, where\nloaded spend is marketing spend PLUS fulfilment waste -- the\nCOGS and shipping spent on kits that were lost or went to\naccounts that never activated. cac_uplift_pct = waste /\nnominal spend.",
      "originalText": "effective_cac = loaded_spend_usd / new_subscriptions, where\nloaded spend is marketing spend PLUS fulfilment waste -- the\nCOGS and shipping spent on kits that were lost or went to\naccounts that never activated. cac_uplift_pct = waste /\nnominal spend.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e2038293501",
