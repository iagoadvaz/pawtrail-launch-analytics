      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "waste_reason is an ordered CASE, not two rows. An account that\nlost its kit AND failed to activate consumed ONE kit, not two\n-- lost kit wins because it is the root cause of the non-\nactivation.",
