      "versionNonce": 23121237,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "WHAT GOES WRONG",
      "originalText": "WHAT GOES WRONG",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e1621459593",
      "type": "text",
      "x": 18,
      "y": 412.0,
      "width": 429.18,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1014040706,
      "version": 1,
      "versionNonce": 1148578451,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Drop the maturity gate from the numerator and Ohio reads 52.2%\ninstead of 51.4%: one Ohio kit is on time but has not finished\nits window. Small here, but it is the same error class that\nmade a whole cohort look like it was failing on the Activation\ntab.",
      "originalText": "Drop the maturity gate from the numerator and Ohio reads 52.2%\ninstead of 51.4%: one Ohio kit is on time but has not finished\nits window. Small here, but it is the same error class that\nmade a whole cohort look like it was failing on the Activation\ntab.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
