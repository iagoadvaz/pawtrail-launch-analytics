      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Sorting is the analysis. Ohio at 51.4% against a next-worst of\n84.2% is a different story from a smooth gradient across\ntwelve states, and only the sorted view shows which one you\nhave.",
      "originalText": "Sorting is the analysis. Ohio at 51.4% against a next-worst of\n84.2% is a different story from a smooth gradient across\ntwelve states, and only the sorted view shows which one you\nhave.",
