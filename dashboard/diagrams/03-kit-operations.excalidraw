    },
    {
      "id": "e1769178213",
      "type": "text",
      "x": 18,
      "y": 335.75,
      "width": 429.18,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1020360332,
      "version": 1,
      "versionNonce": 549846489,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "The single clearest operational finding of the launch. Ohio is\nnot a statistical tail -- it is one carrier relationship, and\nit is the one fix that moves activation nationally.",
      "originalText": "The single clearest operational finding of the launch. Ohio is\nnot a statistical tail -- it is one carrier relationship, and\nit is the one fix that moves activation nationally.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e383725471",
      "type": "text",
      "x": 18,
      "y": 395.5,
      "width": 81.5,
      "height": 12.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
