      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Accounts that never logged in are EXCLUDED from the average,\nnot counted as slow. That is correct (they have no duration to\naverage) but it makes the average optimistic, so the never-\nlogged-in band is shown beside it and cannot hide.",
      "originalText": "Accounts that never logged in are EXCLUDED from the average,\nnot counted as slow. That is correct (they have no duration to\naverage) but it makes the average optimistic, so the never-\nlogged-in band is shown beside it and cannot hide.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
