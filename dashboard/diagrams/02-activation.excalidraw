      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "The five series have five DIFFERENT denominators, because a\n7-day window matures sooner than a 30-day one. They are not a\nfunnel and must never be subtracted from each other.",
      "originalText": "The five series have five DIFFERENT denominators, because a\n7-day window matures sooner than a 30-day one. They are not a\nfunnel and must never be subtracted from each other.",
