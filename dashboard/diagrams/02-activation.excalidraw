      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "WHY IT MATTERS",
      "originalText": "WHY IT MATTERS",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e1527328519",
      "type": "text",
      "x": 682,
      "y": 686.75,
      "width": 429.18,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 137737475,
      "version": 1,
      "versionNonce": 2040109788,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "A distribution, not an average. The average alone hides that\nmost logins happen in the first days and the rest never happen\nat all -- two populations that need different interventions.",
      "originalText": "A distribution, not an average. The average alone hides that\nmost logins happen in the first days and the rest never happen\nat all -- two populations that need different interventions.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e2105307111",
