    {
      "id": "e363201581",
      "type": "text",
      "x": 682,
      "y": 763.0,
      "width": 429.18,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
