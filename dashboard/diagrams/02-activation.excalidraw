      "link": null,
      "locked": false,
      "text": "WHY IT MATTERS",
      "originalText": "WHY IT MATTERS",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e1032846902",
      "type": "text",
      "x": 18,
      "y": 352.0,
      "width": 422.29,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 47868844,
      "version": 1,
      "versionNonce": 494397208,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "The launch's North Star. Attach measures whether people\nbought; activation measures whether the product started\nworking for them. Both legs must succeed, because a delivered\nkit nobody logs in to and a login with no kit are both\nfailures.",
      "originalText": "The launch's North Star. Attach measures whether people\nbought; activation measures whether the product started\nworking for them. Both legs must succeed, because a delivered\nkit nobody logs in to and a login with no kit are both\nfailures.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e2055991746",
