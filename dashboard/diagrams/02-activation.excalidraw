      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Separates which leg is failing. Digital activation holds near\n65% all window; the combined rate tracks the kit SLA line,\nwhich is what identifies fulfilment rather than onboarding as\nthe cause.",
      "originalText": "Separates which leg is failing. Digital activation holds near\n65% all window; the combined rate tracks the kit SLA line,\nwhich is what identifies fulfilment rather than onboarding as\nthe cause.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
