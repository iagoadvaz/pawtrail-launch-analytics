      "roundness": null,
      "seed": 1104947564,
      "version": 1,
      "versionNonce": 63973171,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "activation_rate_30d = combined_activated_accounts_30d /\nmature_accounts_30d. Combined means BOTH legs succeeded: a\ndigital login and a kit delivered inside the 10-day SLA. The\nheadline is cohort-weighted across every fully matured week,\nnot the last week's value.",
      "originalText": "activation_rate_30d = combined_activated_accounts_30d /\nmature_accounts_30d. Combined means BOTH legs succeeded: a\ndigital login and a kit delivered inside the 10-day SLA. The\nheadline is cohort-weighted across every fully matured week,\nnot the last week's value.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
