    {
      "id": "e1611064095",
      "type": "text",
      "x": 18,
      "y": 243.25,
      "width": 415.4,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
