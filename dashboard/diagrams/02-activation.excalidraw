    {
      "id": "e1066154858",
      "type": "text",
      "x": 682,
      "y": 594.25,
      "width": 422.29,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 753219449,
      "version": 1,
      "versionNonce": 1797649145,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786900000000,
      "link": null,
      "locked": false,
      "text": "Accounts bucketed into bands by days from signup to first\nlogin, plus a separate 'never logged in' band. The companion\naverage, avg_days_to_first_login, averages only accounts that\nlogged in within 30 days.",
      "originalText": "Accounts bucketed into bands by days from signup to first\nlogin, plus a separate 'never logged in' band. The companion\naverage, avg_days_to_first_login, averages only accounts that\nlogged in within 30 days.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e1923399980",
